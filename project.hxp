import haxe.io.Path;
import hxp.*;
import lime.tools.*;
import sys.io.File;
import sys.io.Process;
import sys.FileSystem;
import lime.graphics.Image;

using StringTools;

class Project extends HXProject
{
	static final ESC = "\x1B";
	static var COLOR_RESET = ESC + "[0m";
	static var COLOR_WARNING = ESC + "[33m";
	static var COLOR_ERROR = ESC + "[31m";

	static final TITLE:String = "Friday Night Funkin': Shadow Engine";
	static final TITLE_ANDROID:String = "FNF: Shadow Engine";
	static final TITLE_IOS:String = "FNF Shadow Engine";
	static final EXECUTABLE:String = "ShadowEngine";
	static final VERSION:String = "0.10.0";
	static final BUILD_NUMBER:Int = 850;
	static final COMPANY:String = "ShadowEngineTeam";
	static final PACKAGE:String = "org.shadowengineteam.fnf";
	static final MAIN_CLASS:String = "backend.Main";

	static var PRELOADER:String = "backend.FunkinPreloader";
	static final SOURCE_FOLDERS:Array<String> = ["source/engine", "source/haxe_std_shadows"];
	static final LIBRARY_SHADOWS_LIST:Array<String> = ["compatibility"];

	static final FEATURE_MODS:CompileFlag = CompileFlag.get("FEATURE_MODS");
	static final FEATURE_HSCRIPT:CompileFlag = CompileFlag.get("FEATURE_HSCRIPT");
	static final FEATURE_LUA:CompileFlag = CompileFlag.get("FEATURE_LUA");
	static final FEATURE_VIDEOS:CompileFlag = CompileFlag.get("FEATURE_VIDEOS");
	static final FEATURE_DISCORD_RPC:CompileFlag = CompileFlag.get("FEATURE_DISCORD_RPC");
	static final FEATURE_MOBILE_CONTROLS:CompileFlag = CompileFlag.get("FEATURE_MOBILE_CONTROLS");
	static final FEATURE_DCE:CompileFlag = CompileFlag.get("FEATURE_DCE");
	static final FEATURE_TRACY:CompileFlag = CompileFlag.get("FEATURE_TRACY");
	static final FEATURE_FUNKIN_CONTENT:CompileFlag = CompileFlag.get("FEATURE_FUNKIN_CONTENT");
	static final FEATURE_EMBED_ASSETS:CompileFlag = CompileFlag.get("EMBED_ASSETS");
	static final USE_OPENFL_FILESYSTEM:CompileFlag = CompileFlag.get("USE_OPENFL_FILESYSTEM");

	static final ENABLE_ASCII_ART:Bool = true;

	public function new():Void
	{
		super();

		#if !target.unicode
		if (isWindowsHost())
		{
			// Enable code page 65001 for unicode support
			Sys.command("chcp 65001 > nul");
		}
		#end

		CompileFlag.project = this;

		haxe.Log.trace = (v:Dynamic, ?info:haxe.PosInfos) ->
		{
			if (!isDisplay())
				Sys.println(v);
		};

		if (Sys.systemName().toLowerCase() != "windows" && Sys.getEnv('TERM') == null && Sys.getEnv('TERM') != "dumb")
		{
			COLOR_RESET = "";
			COLOR_WARNING = "";
			COLOR_ERROR = "";
		}

		trace("Configuring project...");
		doWelcomeHeader();
		configureApp();
		configureCompileFlags();
		configureAssets();
		configureLibs();
		configureIcons();
		if (!isDisplay())
			checkLibraries();
		trace("Configured project successfully!");
		trace("Starting build...");
		trace("");
	}

	function getHaxeVersion():String
	{
		var process:Process = new Process("haxe", ["-version"]);
		var version:String = "";

		try
		{
			version = process.stdout.readAll().toString().trim();
		}
		catch (e) {}

		process.close();
		return version;
	}

	function doWelcomeHeader()
	{
		var haxeVersion:String = getHaxeVersion().trim();
		var width:Int = 50;

		inline function centerText(text:String, width:Int):String
		{
			var innerWidth:Int = width - 2;
			var padding:Int = Std.int(Math.max(0, Std.int((innerWidth - text.length) / 2)));
			var left:String = StringTools.lpad("", " ", padding);
			var right:String = StringTools.lpad("", " ", innerWidth - text.length - padding);
			return "=" + left + text + right + "=";
		}

		inline function infoLine(label:String, value:String):String
		{
			var innerWidth = width - 2;
			if (label.length == 0)
			{
				// no label: center the value
				var padding:Int = Std.int(Math.max(0, (innerWidth - value.length) / 2));
				var left:String = StringTools.lpad("", " ", padding);
				var right:String = StringTools.lpad("", " ", innerWidth - value.length - padding);
				return "=" + left + value + right + "=";
			}
			else
			{
				var colonPos:Int = Std.int(innerWidth / 2);
				var labelPart:String = StringTools.lpad(label, " ", Std.int(Math.max(0, colonPos - 2)));
				var valuePart:String = value;
				var remainingSpace:Int = Std.int(Math.max(0, innerWidth - (labelPart.length + 3 + valuePart.length)));
				var rightPad:String = StringTools.lpad("", " ", remainingSpace);
				return "=" + labelPart + " : " + valuePart + rightPad + "=";
			}
		}

		var unicode:Bool = #if (target.unicode) true #else false #end;
		var targetPlatform:String = isWeb() ? "Web (HTML5)" : isIOS() ? "iOS" : isAndroid() ? "Android" : isWindows() ? "Windows" : isMac() ? "Mac" : isLinux() ? "Linux" : "Unknown";

		if (isIOSSimulator())
			targetPlatform = "Simulator (" + targetPlatform + ")";

		trace('');
		if (ENABLE_ASCII_ART)
		{
			//var asciiArt = generateAsciiArt("icons/iconOG.png", width - 2, 100);
			// hardcoding here as new image fucked things up and I have no solution for now
			final asciiArt = "11Qm~>Xi{<XtJ~>!?Ou~>_i!>l_+~~]}l| !-fii]!#iLj)-\n11Qm~>Xi{<XtJ~>!?O<~~<<~<<~~~~~~~<<<~<_<]!#iLj)-\n11Qm~>Xi{<XtJ~+~<~<~~~~~~~~~~~~~~~~_1+{_<~^iLj)-\n11Qm~>XiXXXt]<<~~~~~~~~~~~~~~~~~~)]iO-_~+~~iLj)-\n11Qm~>X//<<~~<~~~~~~~~~~~~~~~<[#Lx_+~~~~~_ciLj)-\n11Qm~>{{{~<~~~~~~~~~~~~~~~~~~~~~<~~<~~~~+<iiLj)-\n11Qm~>Xi!~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~<_iiLj)-\n+}~~~+_<~~~~~~~~~~C@@~~~~~~~~~~~~~~~~~~~I:iiLj)-\n##~~~~~~~~~~~~~~-W$$$*<~~~~~~~~~~~~~~~<_>>iiLj)-\n##[~~<~~~~~~~~~_&@@@@@r~~~~~~~~~~~~~~~~cXuiiQx(-\nttt_-~~~~~~~~~~m@$[~m@t~~~~~~~~~~_<?[[_<~<~~~~[1\n!!!!!><~~~~~~~~*@$B1~+~~~~~~~~~~~~~~~~~~~~+~]OOO\ntttttt<~~O?~~~~@@$Bd?~~~~~~~~~~~~~~~~~~~~~_##OOO\ntttttt~-n~w@L_~~~~~~~~~~~~~~~~~~~~~~~~~~_<###+-1\nlllllllll~<<~~~~~~~~~~~~~~~~~~~~~~~~~_{{<<###+-1\n!!!!!!!!!Y)!-i<~~++~<~<Y0x{><~~>>><~<t}{<<###+-1";
			var asciiLines:Array<String> = asciiArt.split("\n");
			for (line in asciiLines)
			{
				var paddedLine:String = StringTools.rpad(line, " ", width - 2);
				trace("=" + paddedLine + "=");
			}
		}
		trace(StringTools.lpad("", "=", width));
		trace(centerText(TITLE, width));
		trace(StringTools.lpad("", "=", width));
		trace(infoLine("Engine Version", 'v${VERSION}'));
		trace(infoLine("Haxe Version", 'v${haxeVersion}'));
		trace(StringTools.lpad("", "=", width));
		trace(infoLine("Target Platform", targetPlatform));
		trace(infoLine("Build Type", isDebug() ? "Debug" : isFinal() ? "Final" : "Release"));
		trace(infoLine("Build Date", Date.now().toString()));
		trace(StringTools.lpad("", "=", width));
		trace('');

		final supportedPlatforms = ["Windows", "Mac", "Linux", "Android", "iOS", "Simulator (iOS)", "Simulator (Android)"];

		if (!supportedPlatforms.contains(targetPlatform))
		{
			warn('Unsupported platform: ${targetPlatform}');
		}
	}

	function configureApp():Void
	{
		if (isIOS())
			meta.title = TITLE_IOS;
		else if (isAndroid())
			meta.title = TITLE_ANDROID;
		else
			meta.title = TITLE;
		meta.version = VERSION;
		meta.buildNumber = Std.string(BUILD_NUMBER);
		meta.company = COMPANY;
		meta.packageName = PACKAGE;

		app.main = MAIN_CLASS;
		app.file = EXECUTABLE;
		app.preloader = PRELOADER;

		var buildDir = 'export/${isDebug() ? 'debug' : 'release'}${FEATURE_TRACY.isEnabled() ? "-tracy" : ""}/' ;
		app.path = buildDir;

		for (shadowName in LIBRARY_SHADOWS_LIST)
			SOURCE_FOLDERS.push('source/library_shadows/${shadowName}');

		sources = sources.concat(SOURCE_FOLDERS);
		templatePaths.push("templates");

		window.width = 1280;
		window.height = 720;
		window.background = 0x000000;
		window.hardware = true;
		window.vsync = false;
		window.orientation = Orientation.LANDSCAPE;

		if (isWeb())
			window.resizable = true;
		else if (isDesktop())
		{
			window.fullscreen = false;
			window.resizable = true;
		}
		else if (isMobile())
		{
			window.fullscreen = true;
			window.resizable = false;
			window.allowShaders = true;
			window.requireShaders = true;
			window.allowHighDPI = true;
		}
	}

	function configureCompileFlags()
	{
		FEATURE_MODS.integrate(isDesktop() || isMobile());
		FEATURE_HSCRIPT.integrate(true);
		FEATURE_LUA.integrate(isDesktop() || isMobile());
		FEATURE_VIDEOS.integrate(isDesktop() || isMobile());
		FEATURE_DISCORD_RPC.integrate(isDesktop());
		FEATURE_MOBILE_CONTROLS.integrate(isMobile());
		FEATURE_DCE.integrate(false);
		FEATURE_TRACY.integrate(false);
		FEATURE_FUNKIN_CONTENT.integrate(true);
		FEATURE_EMBED_ASSETS.integrate(false);

		if (FEATURE_FUNKIN_CONTENT.isEnabled())
			FEATURE_HSCRIPT.integrate(true);

		USE_OPENFL_FILESYSTEM.integrate((FEATURE_MODS.isDisabled() || FEATURE_EMBED_ASSETS.isEnabled()) && !isMobile());

		setHaxedef("FLX_NO_FOCUS_LOST_SCREEN");
		if (!isDebug())
			setHaxedef("FLX_NO_DEBUG");

		setHaxedef("message.reporting", "pretty");
		setHaxedef("lime_disable_assets_version");
		setHaxedef("openfl_dpi_aware");
		setHaxedef("openfl_pool_events");

		setHaxedef("HXCPP_CHECK_POINTER");
		setHaxedef("HXCPP_STACK_LINE");
		setHaxedef("HXCPP_STACK_TRACE");
		setHaxedef("HXCPP_CATCH_SEGV");

		setHaxedef("HXCPP_GC_BIG_BLOCKS"); // still totally unsure btw!

		setHaxedef("USING_SHADOW_ENGINE");

		if (FEATURE_DCE.isDisabled())
			setHaxedef("HXCPP_DEBUG_LINK");

		if (FEATURE_TRACY.isEnabled())
		{
			setHaxedef("HXCPP_TELEMETRY");
			setHaxedef("HXCPP_TRACY");
			setHaxedef("HXCPP_TRACY_MEMORY");
			setHaxedef("HXCPP_TRACY_ON_DEMAND");
			// setHaxedef("HXCPP_TRACY_INCLUDE_CALLSTACKS");

			setHaxedef("absolute-paths"); // Fix source locations so Tracy can see them
		}

		if (FEATURE_HSCRIPT.isEnabled())
		{
			setHaxedef("hscriptPos");
			setHaxedef("HSCRIPT_ABSTRACT_SUPPORT");
			setHaxedef("HSCRIPT_TYPEDEF_SUPPORT");
			setHaxedef("CUSTOM_CLASSES");
		}

		if (isAndroid() && !isDebug())
		{
			final keystoreDir:String = Path.join([Sys.getCwd(), "keystore/android"]);
			var keystorePath:String = Path.join([keystoreDir, "key.keystore"]);
			var jsonPath:String = Path.join([keystoreDir, "keystore.json"]);
			var rawJson:String = '';
			var keyData:Dynamic;

			if (!FileSystem.exists(keystorePath))
			{
				warn('Android keystore not found at: $keystorePath, using dummy.');
				keystorePath = Path.join([keystoreDir, "dummy", "key.keystore"]);
				jsonPath = Path.join([keystoreDir, "dummy", "keystore.json"]);
			}

			try
			{
				rawJson = File.getContent(jsonPath);
			}
			catch (e)
			{
				error('Failed to read Keystore JSON file.');
				Sys.exit(1);
				return;
			}

			try
			{
				keyData = haxe.Json.parse(rawJson);
			}
			catch (e)
			{
				error('Keystore JSON file is not valid JSON.');
				Sys.exit(1);
				return;
			}

			if (keyData == null || !Reflect.hasField(keyData, "alias") || !Reflect.hasField(keyData, "storepass") || !Reflect.hasField(keyData, "keypass"))
			{
				error('Keystore JSON file missing required fields (alias, storepass, keypass)');
				Sys.exit(1);
			}

			keystore = new Keystore();
			keystore.path = keystorePath;
			keystore.alias = Std.string(keyData.alias);
			keystore.password = Std.string(keyData.storepass);
			keystore.aliasPassword = Std.string(keyData.keypass);
		}

		if (isIOS())
			config.set("ios.category_type", "public.app-category.music-games");
		if (isMac())
			config.set("mac.category_type", "public.app-category.music-games");

		if (isMobile())
			setHaxedef("SHARE_MOBILE_FILES");

		if (FEATURE_DCE.isDisabled())
		{
			addHaxeFlag("-dce no");
			addMacroFlag("macros.KeepMacro.keepClasses()");
		}

		// see https://haxe.org/manual/cr-static-analyzer.html
		// setHaxedef("analyzer-optimize");


		if (isMobile() || isWeb())
			setHaxedef("TOUCH_HERE_TO_PLAY");
	}

	function configureAssets()
	{
		final embed:Bool = FEATURE_EMBED_ASSETS.isEnabled();

		includeAssetLibrary("default", true, false);

		if (FEATURE_FUNKIN_CONTENT.isEnabled())
		{
			addAssetPath("assets/funkin_resources/fonts", 'assets/fonts', true);
			addAssetPath("assets/funkin_resources/shared", 'assets/shared', embed);
		}

		addAssetPath("assets/embed", null, true);
		addAssetPath("assets/fonts", null, true);
		addAssetPath("assets/shared", null, embed);

		if (FEATURE_MOBILE_CONTROLS.isEnabled())
			addAssetPath("assets/mobile", 'assets/shared/mobile', embed);

		final textureFormats:Array<String> = ["ASTC", "BC"];
		var hasFormat:Bool = false;

		for (format in textureFormats)
			if (defines.exists(format))
				setHaxedef("USING_GPU_TEXTURES");

		var needsPNG:Bool = true;
		for (format in textureFormats)
		{
			if (defines.exists(format))
			{
				needsPNG = false;
				if (FEATURE_MOBILE_CONTROLS.isEnabled())
					addAssetPath('assets/mobile-images/${format.toLowerCase()}', 'assets/shared/images', embed);
				if (FEATURE_FUNKIN_CONTENT.isEnabled())
					addAssetPath('assets/funkin_resources/images-${format.toLowerCase()}', 'assets/shared/images', embed);
				addAssetPath('assets/images-${format.toLowerCase()}', 'assets/shared/images', embed);
			}
		}

		if (needsPNG)
		{
			if (FEATURE_MOBILE_CONTROLS.isEnabled())
				addAssetPath('assets/mobile-images/png', 'assets/shared/images', embed);
			if (FEATURE_FUNKIN_CONTENT.isEnabled())
				addAssetPath('assets/funkin_resources/images-png', 'assets/shared/images', embed);
			addAssetPath('assets/images-png', 'assets/shared/images', embed);
		}

		if (isLinux() && !isDebug())
			addAsset("gamemode.ini");
	}

	function configureLibs()
	{
		includeHaxelib("flixel");
		includeHaxelib("flixel-addons");
		includeHaxelib("flixel-animate");

		if (FEATURE_LUA.isEnabled())
			includeHaxelib("hxluau");
		if (FEATURE_HSCRIPT.isEnabled())
			includeHaxelib("SScript");
		if (FEATURE_VIDEOS.isEnabled())
		{
			setHaxedef("HXVLC_EXPORT_DIR", '${app.path}');
			includeHaxelib("hxvlc");
		}
		if (FEATURE_DISCORD_RPC.isEnabled())
			includeHaxelib("hxdiscord_rpc");
		//if (FEATURE_FUNKIN_CONTENT.isEnabled())
		//{
			includeHaxelib("funkin.vis");
			includeHaxelib("grig.audio");
		//}

		if (isDebug() && isCPP())
			includeHaxelib("hxcpp-debug-server");

		if (isLinux() && !isDebug())
			includeHaxelib("hxgamemode");
	}

	function configureIcons()
	{
		if (isAndroid())
			adaptiveIcon = new AdaptiveIcon('icons/android/', true);
		else if (isIOS())
		{
			final sizes:Map<String, Int> = [
				"20x20@1x" => 20,
				//"20x20@2x" => 40, // also used by 40x40@1x
				"20x20@3x" => 60,
				"29x29@1x" => 29,
				"29x29@2x" => 58,
				"29x29@3x" => 87,
				"40x40@1x" => 40,
				"40x40@2x" => 80,
				//"40x40@3x" => 120, // also used by 60x60@2x
				"60x60@2x" => 120,
				"60x60@3x" => 180,
				"76x76@1x" => 76,
				"76x76@2x" => 152,
				"83.5x83.5@2x" => 167,
				"1024x1024" => 1024
			];

			for (path => px in sizes)
				addIcon('icons/ios/SE-Icon-Default-${path}.png', px);

			addIcon("icons/ios/SE-Icon-Default-1024x1024.png"); // lime requires default aswell
		}
		else
		{
			for (size in [16, 32, 64])
				addIcon('icons/desktop/icon${size}.png', size);
			addIcon('icons/desktop/iconOG.png');
		}
	}

	function includeHaxelib(name:String, version:String = ""):Void
		haxelibs.push(new Haxelib(name, version));

	function addAsset(path:String, ?rename:String, embed:Bool = false):Void
	{
		var asset:Asset = new Asset(path, rename, null, embed, true);
		asset.library = "default";
		assets.push(asset);
	}

	public function addAssetPath(path:String, ?rename:String, embed:Bool = false):Void
	{
		if (path == "")
			return;

		var targetPath:String = Path.addTrailingSlash(rename ?? path);

		if (!FileSystem.exists(path))
			error('Path "${path}" was not found');
		else if (!FileSystem.isDirectory(path))
			error('Path "${path}" needs to be a directory.');

		for (file in FileSystem.readDirectory(path))
		{
			if (FileSystem.isDirectory('${path}/${file}'))
				addAssetPath('${path}/${file}', '${targetPath}${file}', embed);
			else
				addAsset('${path}/${file}', '${targetPath}${file}', embed);
		}
	}

	function includeAssetLibrary(name:String, embed:Bool = false, preload:Bool = false):Void
		libraries.push(new Library('', name, null, embed, preload, false, ""));

	function generateAsciiArt(imagePath:String, targetWidth:Int, maxHeight:Int = 20):String
	{
		try
		{
			var image:Image = Image.fromFile(imagePath);
			if (image == null)
				throw "Image could not be loaded.";

			var scaleX:Float = targetWidth / image.width;
			var scaleY:Float = (maxHeight / image.height) * 0.5; // compensate for tall text characters
			var scale:Float = Math.min(scaleX, scaleY); // maintain aspect ratio

			var newWidth:Int = Math.round(image.width * scale);
			var newHeight:Int = Math.round(image.height * scale);
			if (newWidth <= 0)
				newWidth = 1;
			if (newHeight <= 0)
				newHeight = 1;

			var chars:String = " .'`^\",:;Il!i><~+_-?][}{1)(|\\/tfjrxnuvczXYUJCLQ0OZmwqpdbkhao*#MW&8%B@$"; // light to dark

			var result:Array<String> = [];
			for (y in 0...newHeight)
			{
				if (y % 2 == 1)
					continue;

				var line = "";
				for (x in 0...newWidth)
				{
					var origX = Math.floor(x / scale);
					var origY = Math.floor(y / scale);
					if (origX >= image.width || origY >= image.height)
					{
						line += " ";
						continue;
					}

					var color = image.getPixel32(origX, origY);
					var r = (color >> 16) & 0xFF;
					var g = (color >> 8) & 0xFF;
					var b = color & 0xFF;
					var gray = Math.round(0.299 * r + 0.587 * g + 0.114 * b);

					var index = Math.floor((gray / 255) * (chars.length - 1));
					line += chars.charAt(index);
				}

				var padding = Math.floor((targetWidth - newWidth) / 2);
				line = StringTools.lpad("", " ", padding) + line + StringTools.rpad("", " ", targetWidth - newWidth - padding);
				result.push(line);
			}

			return result.join("\n");
		}
		catch (e:Dynamic)
		{
			return "ASCII Art Load Failed.";
		}
	}

	function checkLibraries():Void
	{
		var diffs = new Map<String, Array<String>>();
		var data:Dynamic = haxe.Json.parse(sys.io.File.getContent(#if ios '../../../../../' #end 'hmm.json'));
		var dependencies:Array<Dynamic> = data.dependencies;

		inline function hbPath(libName:String, ?file:String)
		{
			return haxe.io.Path.join([Sys.getCwd(), ".haxelib", libName, if (file != null) file else ""]);
		}

		inline function read(libName:String, file:String):String
		{
			var path = hbPath(libName, file);
			return sys.FileSystem.exists(path) ? sys.io.File.getContent(path).trim() : "";
		}

		function getGitHash(libName:String):String
		{
			var gitDir = hbPath(libName, "git");
			var pathToCheck = sys.FileSystem.exists(gitDir) ? gitDir : null;

			if (pathToCheck == null)
			{
				var devContent = read(libName, ".dev");
				if (devContent != "" && sys.FileSystem.exists(devContent)) pathToCheck = devContent;
			}

			if (pathToCheck == null)
				return "";

			try
			{
				var p = new sys.io.Process("git", ["-C", pathToCheck, "rev-parse", "HEAD"]);
				var hash = p.stdout.readAll().toString().trim();
				p.close();
				return hash;
			}
			catch (e)
				return "";
		}

		for (lib in dependencies)
		{
			var name:String = lib.name;
			var key = name.replace(".", ",");

			var devFile = read(key, ".dev");
			var currentVer = read(key, ".current");
			var gitHash = getGitHash(key);

			var isLocalGitDev = false;
			if (devFile != "" && sys.FileSystem.exists(hbPath(key, "git"))) {
				isLocalGitDev = Path.normalize(devFile).startsWith(Path.normalize(hbPath(key, "git")));
			}

			if (devFile != "" && !isLocalGitDev)
			{
				var current = gitHash;
				var expected = (lib.type == "git") ? lib.ref : lib.version;

				if (lib.type == "git" ? (current != expected) : true) {
					diffs.set(key, [devFile, current, expected, lib.type]);
				}
			}
			else
			{
				if (lib.type == "haxelib")
				{
					if (currentVer != lib.version)
					{
						diffs.set(key, ["", currentVer, lib.version, "haxelib"]);
					}
				}
				else if (lib.type == "git")
				{
					if (gitHash != lib.ref)
					{
						diffs.set(key, ["", gitHash, lib.ref, "git"]);
					}
				}
			}
		}

		if (Lambda.count(diffs) > 0)
		{
			Sys.println("Some libraries differ from the versions defined in hmm.json.");
			Sys.println("To ensure consistency, it's recommended to stop the build and run `hmm reinstall [library]`.");
			Sys.println("");

			for (key in diffs.keys())
			{
				var info = diffs.get(key);
				if (info == null)
					continue;

				var devPath = info[0];
				var current = info[1];
				var expected = info[2];
				var type = info[3];
				var displayName = key.replace(",", ".");

				if (haxe.io.Path.isAbsolute(devPath))
				{
					Sys.println('- $displayName (Development Build)');
					Sys.println('   Path:     ${haxe.io.Path.removeTrailingSlashes(devPath)}');
				}
				else
				{
					Sys.println('- $displayName');
				}

				Sys.println('   Current:  $current');
				Sys.println('   Expected: $expected');
			}

			Sys.println("");
		}
	}

	inline function addIcon(icon:String, ?size:Int):Void
		icons.push(new Icon(icon, size));

	inline function addHaxeFlag(value:String):Void
		haxeflags.push(value);

	inline function addMacroFlag(value:String):Void
		addHaxeFlag('--macro ${value}');

	inline function isDebug():Bool
		return debug;

	inline function isRelease():Bool
		return !isDebug();

	inline function isFinal():Bool
		return targetFlags.exists("final");

	inline function isDisplay():Bool
		return command == "display";

	inline function isWindowsHost():Bool
		return System.hostPlatform == WINDOWS;

	inline function isMacHost():Bool
		return System.hostPlatform == MAC;

  	inline function isLinuxHost():Bool
		return System.hostPlatform == LINUX;

	inline function isWeb():Bool
		return platformType == PlatformType.WEB;

	inline function isMobile():Bool
		return platformType == PlatformType.MOBILE;

	inline function isDesktop():Bool
		return platformType == PlatformType.DESKTOP;

	inline function isWindows():Bool
		return target == Platform.WINDOWS;

	inline function isMac():Bool
		return target == Platform.MAC;

	inline function isLinux():Bool
		return target == Platform.LINUX;

	inline function isAndroid():Bool
		return target == Platform.ANDROID;

	inline function isIOS():Bool
		return target == Platform.IOS;
	
	inline function isIOSSimulator():Bool
		return target == Platform.IOS && targetFlags.exists("simulator");

	inline function isCPP():Bool
		return defines.exists("cpp");

	public inline function getHaxedef(name:String):Null<Dynamic>
		return haxedefs.get(name);

	public inline function setHaxedef(name:String, ?value:String):Void
		haxedefs.set(name, value ?? "");

	public inline function unsetHaxedef(name:String):Void
		haxedefs.remove(name);

	public inline function getDefine(name:String):Null<Dynamic>
		return defines.get(name);

	public inline function setDefine(name:String, ?value:String):Void
		defines.set(name, value ?? "");

	public inline function unsetDefine(name:String):Void
		defines.remove(name);

	inline function warn(message:String):Void
		trace('${COLOR_WARNING}[WARNING]${COLOR_RESET} ${message}');

	inline function error(message:String):Void
		trace('${COLOR_ERROR}[ERROR]${COLOR_RESET} ${message}');
}

class CompileFlag
{
	public static final INVERSION:String = "NO_";
	public static var project:Project;

	public static function get(name:String):CompileFlag
		return new CompileFlag(name);

	var name:String;

	public function new(name:String)
		this.name = name;

	public function enable(stopPropagation:Bool = false):Void
	{
		project.setHaxedef(name);
		project.setDefine(name);
		if (!stopPropagation)
			getInverse().disable(true);
	}

	public function disable(stopPropagation:Bool = false):Void
	{
		project.unsetHaxedef(name);
		project.unsetDefine(name);
		if (!stopPropagation)
			getInverse().enable(true);
	}

	public function integrate(defaultEnabled:Bool = false):Void
	{
		var inverse = getInverse();

		if (isEnabled())
			inverse.disable(true);
		else if (inverse.isEnabled())
			disable(true);
		else
			(defaultEnabled ? enable : disable)(true);
	}

	public function isEnabled():Bool
		return project.haxedefs.exists(name) || project.defines.exists(name);

	public function isDisabled():Bool
		return getInverse().isEnabled() || !isEnabled();

	function getInverse():CompileFlag
	{
		var inversionName = name;
		if (!inversionName.startsWith(INVERSION))
			inversionName = INVERSION + inversionName;
		return new CompileFlag(inversionName);
	}
}
